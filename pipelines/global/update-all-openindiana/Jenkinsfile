// Update BaseOS on all openindiana nodes

@Library(['GlobalLib@ilias-testing', 'ProjectLib@ilias-testing']) _

def info = [:]
def project = 'update-all-openindiana'

// Generate the run-list
def buildFullRunMap(Map info)
{
    def collectBuildEnv = [:]
    def nodeList = getUpNodesByLabel(info['packager'])

    for (def n in nodeList) {
	def node = n
	collectBuildEnv[node] = {
	    // Once transition is done, we can stop passing 'built-in' completely here
	    updateOSNode('built-in', info, node)
	}
    }

    return collectBuildEnv
}

pipeline {
    agent { label 'built-in' }

    stages {
        stage('update BaseOS') {
            steps {
		script {
		    info['project'] = project
		    info['packager'] = 'openindiana'
		    getBuildInfoCommon(info)
		    info['state'] = 'success'
		    info['branch'] = ''
		    info['stages_run'] = 0
		    info['stages_fail'] = 0
		    info['stages_fail_nodes'] = ''

		    // Now do all of the other nodes
		    def updates = buildFullRunMap(info)
		    try {
			parallel updates
			info['state'] = 'completed'
		    } catch (err) {
			println("Jenkinsfile caught "+err)
			info['exception_text'] += "\nparallel error caught: {$err}\n"
			info['state'] = 'error'
		    }
		}
	    }
        }
    }

    // Finish up and send emails
    post {
	always {
	    projectFinishUp(info)
	}
    }
}
