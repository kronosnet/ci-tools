@Library(['GlobalLib@fab-devel', 'GitlabLib@fab-devel', 'ProjectLib@fab-devel']) _

def info = [:]
def project = 'kubesan'

def test_list = ''
def ret = 'SUCCESS'
def testret = ''

pipeline {
    agent { label 'kubesan' }

    options {
	gitLabConnection('gitlab-knet-ci-bot')
	gitlabBuilds(builds: ['jenkins-ci'])
	skipDefaultCheckout(true)
    }

    environment {
	GOPROXY = 'https://nexus.corp.redhat.com/repository/go-all,direct'
    }

    stages {
	stage('Prep build env') {
	    steps {
		updateGitlabCommitStatus(name: 'Prep build env', state: 'running')
		script {
		    getBuildInfoCommon(info)

		    setMultibranchSkipStrategy(getProjectSkipRegex(), getProjectSkipFiles())

		    // GitlabLib's updateGitlabStatus()/postMRRef() expect these. They are
		    // normally set by gitlab's getBuildInfo(), which kubesan does not call.
		    info['isPullRequest'] = env.CHANGE_ID ? true : false
		    info['pull_id'] = env.CHANGE_ID

		    cleanWs(disableDeferredWipeout: true, deleteDirs: true)
		    def scmVars = checkout scm

		    // skipDefaultCheckout(true) means nothing populates env.GIT_COMMIT
		    // for us, and the checkout step only returns it. postMRRef() posts
		    // to /statuses/$GIT_COMMIT, so export it before reporting status.
		    env.GIT_COMMIT = scmVars.GIT_COMMIT

		    // Where the images are built and, on publish branches,
		    // pushed. Exported into the environment rather than
		    // interpolated into the shell snippets below, so that the
		    // build and the push cannot disagree on the name.
		    env.KSAN_IMAGE = 'quay.io/kubesan/kubesan'

		    updateGitlabStatus(info, [state: 'running', description: 'Jenkins build started'])
		    test_list = sh (label: 'Gather test list', returnStdout: true,
			script: """
			    grep ksan-supported-modes tests/t/*.sh | { while read line; do
				testname=\$(echo \$line | sed -e 's#.*t/##g' -e 's#.sh:.*##g')
				testmodes=\$(echo \$line | sed -e 's#.*supported-modes ##g')
				for mode in \$testmodes; do
				    echo "\$testname:\$mode"
				done
			    done; }
			""").trim()
		}
		updateGitlabCommitStatus(name: 'Prep build env', state: 'success')
	    }
	}
	stage('Build container') {
	    steps {
		updateGitlabCommitStatus(name: 'Build container', state: 'running')
		script {
		    try {
			// 'images-all' builds every image in dependency order:
			// the two pre-built dependency images, then the lint
			// image (which also verifies the generated files are up
			// to date), the kubesan image and the e2e test image.
			// The kubesan image is tagged with its final name here
			// so that the push stage below has nothing left to build.
			sh (label: 'Run local build',
			    script: '''
				su - kubesan /bin/bash -c "cd $WORKSPACE; make images-all IMG=$KSAN_IMAGE:latest"
			    ''')
		    } catch (err) {
			updateGitlabCommitStatus(name: 'Build container', state: 'failed')
			ret = 'FAILURE'
			catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
			    shNoTrace("exit 1", "Marking this stage as a failure")
			}
			error('Build failure')
		    }
		}
		updateGitlabCommitStatus(name: 'Build container', state: 'success')
	    }
	}
	stage('Run tests') {
	    steps {
		script {
		    for (testrun in test_list.split()) {
			def test = testrun.split(':', 2)
			def testmode = test[1]
			if (test[1] == 'Any') {
			    testmode = 'Thin'
			}
			testret = 'success'
			def logsrc = "${test[0]}_${testmode}"
			updateGitlabCommitStatus(name: "Test: ${test[0]} Mode: ${test[1]}", state: 'running')
			stage("Test: ${test[0]} Mode: ${test[1]}") {
			   try {
				sh """
				    mkdir -p ${WORKSPACE}/test_logs
				    chown kubesan:kubesan ${WORKSPACE}/test_logs
				    su - kubesan /bin/bash -c "cd ${WORKSPACE}; ./tests/run.sh --use-cache --collect-logs-always --collect-logs-to ${WORKSPACE}/test_logs/${logsrc}.tar.xz --mode ${testmode} tests/t/${test[0]}.sh"
				"""
			   } catch (err) {
				ret = 'FAILURE'
				testret = 'failed'
				catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
				    shNoTrace("exit 1", "Marking this stage as a failure")
				}
			   }
			}
			// Archive test logs
			sh """
			    if [ -f "${WORKSPACE}/test_logs/${logsrc}.tar.xz" ]; then
				if [ "${testret}" = "success" ]; then
				    mv "${WORKSPACE}/test_logs/${logsrc}.tar.xz" "${WORKSPACE}/test_logs/SUCCESS_${logsrc}.tar.xz"
				else
				    mv "${WORKSPACE}/test_logs/${logsrc}.tar.xz" "${WORKSPACE}/test_logs/FAILED_${logsrc}.tar.xz"
				fi
			    fi
			"""
			def logfile = (testret == 'success') ? "SUCCESS_${logsrc}.tar.xz" : "FAILED_${logsrc}.tar.xz"
			if (fileExists("${WORKSPACE}/test_logs/${logfile}")) {
			    archiveArtifacts artifacts: "test_logs/${logfile}", fingerprint: false
			}
			updateGitlabCommitStatus(name: "Test: ${test[0]} Mode: ${test[1]}", state: "${testret}")
		    }
		}
	    }
	}
	stage('Push images') {
	    // Only publish from a branch listed in getPublishBranches(), and
	    // only when every build and test stage passed: the test stages
	    // swallow their failure through catchError() so that the whole
	    // matrix still runs, and record it in ret.
	    when {
		beforeAgent true
		expression {
		    return ret == 'SUCCESS' &&
			   !info['isPullRequest'] &&
			   isThisAPublishBranch(env.BRANCH_NAME) == 1
		}
	    }
	    steps {
		updateGitlabCommitStatus(name: 'Push images', state: 'running')
		script {
		    try {
			withCredentials([usernamePassword(credentialsId: 'kubesan-quay',
							  usernameVariable: 'QUAY_USER',
							  passwordVariable: 'QUAY_PASSWORD')]) {
			    // Single quoted on purpose: the credentials must reach
			    // the shell as environment variables rather than being
			    // interpolated into the script by Groovy. The password
			    // is fed to podman on stdin, so it never appears in a
			    // command line.
			    sh (label: 'Push images to quay.io',
				script: '''
				    set +x
				    sha="$(echo "$GIT_COMMIT" | cut -c1-12)"
				    printf '%s' "$QUAY_PASSWORD" |
					su - kubesan /bin/bash -c "podman login --username $QUAY_USER --password-stdin quay.io"
				    su - kubesan /bin/bash -c "podman tag $KSAN_IMAGE:latest $KSAN_IMAGE:$sha"
				    su - kubesan /bin/bash -c "cd $WORKSPACE; make push IMG=$KSAN_IMAGE:latest"
				    su - kubesan /bin/bash -c "cd $WORKSPACE; make push IMG=$KSAN_IMAGE:$sha"
				    su - kubesan /bin/bash -c "cd $WORKSPACE; make push-test-image"
				    su - kubesan /bin/bash -c "cd $WORKSPACE; make push-deps-images"
				''')
			}
		    } catch (err) {
			updateGitlabCommitStatus(name: 'Push images', state: 'failed')
			ret = 'FAILURE'
			catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
			    shNoTrace("exit 1", "Marking this stage as a failure")
			}
			error('Push failure')
		    }
		}
		updateGitlabCommitStatus(name: 'Push images', state: 'success')
	    }
	}
    }
    post {
	always {
	    // Never leave registry credentials behind on the agent. This is a
	    // no-op, and harmlessly non-zero, when the push stage did not run.
	    sh (label: 'Log out of quay.io',
		script: '''
		    su - kubesan /bin/bash -c "podman logout quay.io" || true
		''')
	    node('built-in') {
		// Copy logs
		stagingCleanAndCopy(info)
	    }
	    RWLock(info, 'UNLOCK')
	    cleanWs(disableDeferredWipeout: true, deleteDirs: true)
	    script {
		currentBuild.result = ret
	    }
	}
	// always{} runs first, so these see the result set above. Taking the
	// state from Jenkins rather than from ret means an aborted build
	// reports canceled instead of success: ret is only ever set to
	// FAILURE by a catch block, and an abort runs neither of them.
	success {
	    script {
		updateGitlabStatus(info, [state: 'success', description: 'Jenkins build succeeded'])
	    }
	}
	failure {
	    script {
		updateGitlabStatus(info, [state: 'failed', description: 'Jenkins build failed'])
	    }
	}
	aborted {
	    script {
		updateGitlabStatus(info, [state: 'canceled', description: 'Jenkins build was canceled'])
	    }
	}
    }
}
